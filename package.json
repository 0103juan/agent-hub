{
  "name": "agent-hub",
  "displayName": "AgentHub (Multi-Subscription & MCP Orchestrator)",
  "description": "Orquesta tus cuentas de Claude Pro, Google Antigravity y GPT sin API keys, con contexto de archivos y MCPs",
  "version": "0.1.0",
  "author": {
    "name": "AgentHub Team",
    "email": "support@agenthub.dev"
  },
  "main": "dist/electron/main.js",
  "bin": {
    "agent-hub": "./bin/agent-hub.js"
  },
  "scripts": {
    "build:standalone": "esbuild src/server/standalone.ts --bundle --minify --outfile=dist/standalone.js --alias:vscode=./src/server/vscode-shim.ts --format=cjs --platform=node --sourcemap",
    "build:electron": "esbuild src/electron/main.ts --bundle --minify --outfile=dist/electron/main.js --alias:vscode=./src/server/vscode-shim.ts --external:electron --format=cjs --platform=node",
    "build:webview": "vite build",
    "build": "npm run build:standalone && npm run build:electron && npm run build:webview",
    "start:server": "node bin/agent-hub.js",
    "desktop": "node bin/agent-hub.js --desktop",
    "desktop:electron": "npm run build:webview && npm run build:electron && electron dist/electron/main.js",
    "package:win": "npm run build && electron-builder --win --x64",
    "app": "node bin/agent-hub.js --desktop",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "esbuild tests/agent-hub.test.ts --bundle --platform=node --alias:vscode=./src/server/vscode-shim.ts --outfile=tests/dist.test.js && node --test tests/dist.test.js && npm run test:flows",
    "test:flows": "esbuild tests/flows.test.ts --bundle --platform=node --alias:vscode=./src/server/vscode-shim.ts --outfile=tests/dist.flows.test.js && node --test tests/dist.flows.test.js",
    "watch:webview": "vite build --watch",
    "dev": "npm run build",
    "update": "pwsh -NoProfile -File actualizar.ps1"
  },
  "build": {
    "appId": "com.agenthub.desktop",
    "productName": "AgentHub",
    "copyright": "Copyright © 2026 AgentHub",
    "asar": false,
    "directories": {
      "output": "dist_package"
    },
    "files": [
      "dist/electron/**/*",
      "dist/webview/**/*",
      "resources/**/*"
    ],
    "extraMetadata": {
      "main": "dist/electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "legalTrademarks": "AgentHub Team",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentHub",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.21.5",
    "lucide-react": "^0.395.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
